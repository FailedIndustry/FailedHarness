{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T3 Code review claims file",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "statement"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "claims"
  ],
  "additionalProperties": true
}
